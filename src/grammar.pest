
// ~ followed by
// | or
// ()+ one or many
// SOI EOI Start of input, End of Input
// _{} wrapper: no node created

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

Program = _{ SOI ~ Expr ~ (";" ~ Expr)* ~ ";"? ~ EOI }
    Expr = { Additive }
        Additive = { Multiplicative ~ ((AddOperator ~ Multiplicative)*) }
            Multiplicative = { UnaryExpr ~ ((MulOperator ~ UnaryExpr)*) }
        UnaryExpr = { Prefix? ~ Primary }
        Primary = { Int | "(" ~ Expr ~ ")" }
            Int = @{ ASCII_DIGIT+ }

AddOperator = { "+" | "-" }
MulOperator = { "*" | "/" }
Prefix = { "+" | "-" }





