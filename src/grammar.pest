/*
 * This is the grammar file used by PEST.
 * Author: Erik Bamberg
 * Initial commit: 2026-10-19
 */

// ~ followed by
// | or
// ()+ one or many
// SOI EOI Start of input, End of Input
// _{} wrapper: no node created

WHITESPACE = _{ " " | "\t" | "\r" | "\n" }

Program = _{ SOI ~ (Stmt ~ (";" ~ Stmt)* ~ ";"?)? ~ EOI }
Stmt = _{ Conditional | Assignment | Expr }
Expr = { Comparison }
Comparison = { Additive ~ (CompOp ~ Additive)* }
Additive = { Multiplicative ~ ((AddOperator ~ Multiplicative)*) }
Multiplicative = { UnaryExpr ~ ((MulOperator ~ UnaryExpr)*) }
UnaryExpr = { Prefix? ~ Primary }
Primary = { Literal | Identifier | "(" ~ Expr ~ ")" }


/* ----------------------------------------------------------------
 *                              TYPES
 * ---------------------------------------------------------------- */
Literal = _{ Bool | Int }
Int = @{ ASCII_DIGIT+ }
Bool = { "true" | "false" }

Type = { IntTypeIdent | BoolTypeIdent }
IntTypeIdent = { "int" }
BoolTypeIdent = { "bool" }


/* ----------------------------------------------------------------
 *                             KEYWORDS
 * ---------------------------------------------------------------- */
KEYWORD = @{ "let" | "fn" | "if" | "else" | "while" | "true" | "false" | "return" }
CompOp = { "<=" | ">=" | "<" | ">" | "==" | "!=" }


/* ----------------------------------------------------------------
 *                      FUNCTIONS AND VARIABLES
 * ---------------------------------------------------------------- */
Identifier = @{ !KEYWORD ~ (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")* }

// Function = { "fn" ~ Identifier ~ "(" ~ Params? ~ ")" ~ Block }  // Example: fn add(a, b) { return a + b }

// Variable assignment
Assignment = { "let" ~ Identifier ~ (":" ~ Type)? ~ "=" ~ Expr } // Example: let x = 42

// Return statement
// Return = { "return" ~ Expr } // Example: return x + 1


/* ----------------------------------------------------------------
 *                           CONTROL FLOW
 * ---------------------------------------------------------------- */

Conditional = { "if" ~ "(" ~ Expr ~ ")" ~ Block ~ ("else" ~ Block)? }
// WhileLoop = { "while" ~ "(" ~ Expr ~ ")" ~ Block }
// Block of statements
Block = { "{" ~ (Stmt ~ (";" ~ Stmt)* ~ ";"?)? ~ "}" }

AddOperator = { "+" | "-" }
MulOperator = { "*" | "/" }
Prefix = { "+" | "-" | "!" }





